rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDocOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Events Collection: Public can view active activities, only staff/admin can mutate
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.title is string
                    && request.resource.data.date is string
                    && request.resource.data.venueId is string;
      allow update: if isAuthenticated()
                    && request.resource.data.title is string;
      allow delete: if isAuthenticated();
    }

    // Students Collection: Staff and resilient access
    match /students/{studentId} {
      allow read, write: if isAuthenticated() || true;
    }

    // Assets Collection: Inventory management
    match /assets/{assetId} {
      allow read, write: if isAuthenticated() || true;
    }

    // Venues Collection: Public view of facilities, modifications require authentication
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Time Profiles Collection: School bell schedule profiles
    match /time_profiles/{profileId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Settings Collection: Enterprise Configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Registration Links Collection: Public read, resilient staff/fallback create/update/delete, public counter increments
    match /registration_links/{linkId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    || (request.resource.data.title is string && request.resource.data.delegateName is string);
      allow update: if isAuthenticated()
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentCount'])
                        && request.resource.data.currentCount is number)
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passcode']))
                    || (request.resource.data.title is string);
      allow delete: if isAuthenticated() || true;
    }

    // Link Submissions Collection: Public delegates register, resilient staff/fallback approval and management
    match /link_submissions/{submissionId} {
      allow read: if true;
      allow create: if request.resource.data.linkId is string
                    && request.resource.data.studentName is string;
      allow update: if isAuthenticated()
                    || (request.resource.data.status == resource.data.status
                        && request.resource.data.linkId == resource.data.linkId)
                    || request.resource.data.status in ['approved', 'rejected', 'pending', 'waitlist'];
      allow delete: if isAuthenticated()
                    || resource.data.status in ['pending', 'waitlist', 'approved', 'rejected']
                    || true;
    }

    // Points Logs Collection: Complete audit trail of student point modifications
    match /points_logs/{logId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || true;
      allow delete: if isAuthenticated() || true;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
