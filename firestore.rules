rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDocOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Events Collection: Public can view active activities, only staff/admin can mutate
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.title is string
                    && request.resource.data.date is string
                    && request.resource.data.venueId is string;
      allow update: if isAuthenticated()
                    && request.resource.data.title is string;
      allow delete: if isAuthenticated();
    }

    // Students Collection: Strict privacy protection - authenticated staff only
    match /students/{studentId} {
      allow read, write: if isAuthenticated();
    }

    // Assets Collection: Inventory management - authenticated staff only
    match /assets/{assetId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Venues Collection: Public view of facilities, modifications require authentication
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Time Profiles Collection: School bell schedule profiles
    match /time_profiles/{profileId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Settings Collection: Enterprise Configuration
    // Global school settings (school name, term calendar, bell schedules) are readable by public/view and clients
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Registration Links Collection: Public read for active links, staff create/update/delete, public counter increments
    match /registration_links/{linkId} {
      allow read: if true;
      allow create, delete: if isAuthenticated();
      allow update: if isAuthenticated() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentCount'])
        && request.resource.data.currentCount is number
      );
    }

    // Link Submissions Collection: Public delegates register and manage entries, staff full control
    match /link_submissions/{submissionId} {
      allow read: if true;
      allow create: if request.resource.data.linkId is string
                    && request.resource.data.studentName is string;
      allow update: if isAuthenticated()
                    || (request.resource.data.status == resource.data.status
                        && request.resource.data.linkId == resource.data.linkId);
      allow delete: if isAuthenticated()
                    || resource.data.status in ['pending', 'waitlist', 'approved'];
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
